# Provision these on the chosen host. No workstation wallet/session files are uploaded.
INONU_DOMAIN=example.com
INONU_OWNER=owner
# Gateway credential goes only in deploy/secrets/gateway_token, never in this file.
INONU_SMTP_ADDRESS=submissions://smtp.example.com:465
INONU_SMTP_USERNAME=REPLACE_WITH_SMTP_USER
INONU_SMTP_SENDER=Inonu <notifications@example.com>
