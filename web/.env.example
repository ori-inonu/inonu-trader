# Optional public feed address. The wallet panels read balances in the browser; the multichain
# panel sends the connected address to public third-party RPCs (one per network) when you click
# "Consultar todas as redes", and the Solana panel sends the Solana account to the Solana RPC.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
# Where the desk reads the Jev tape reads (GET /jev-read). Defaults to NEXT_PUBLIC_API_URL; set it when the producer
# runs on its own port (bun run jev-read --jev --serve 3100). The browser origin must be in OPERATOR_DASHBOARD_ORIGINS.
# NEXT_PUBLIC_JEV_READ_URL=http://127.0.0.1:3100
# Optional RPC overrides per OKX chainIndex (public URLs only; these values ship to every visitor).
# NEXT_PUBLIC_EVM_RPC_196=https://rpc.xlayer.tech
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Never place wallet secrets, API keys or authenticated RPC URLs in NEXT_PUBLIC variables.
