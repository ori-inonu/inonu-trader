{
  "name": "inonu-trader",
  "version": "0.0.2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.0",
    "@kuru-labs/kuru-sdk": "^0.0.95",
    "ai": "^7.0.103",
    "ethers": "5"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "doctor": "bun run scripts/doctor.ts",
    "capture": "bun run scripts/capture.ts",
    "backtest": "bun run scripts/backtest.ts",
    "test": "bun --no-env-file test --parallel=1 --timeout 15000 ./src ./scripts",
    "test:all": "bun --no-env-file run test && bun --no-env-file run --cwd web test",
    "typecheck": "tsc --noEmit -p tsconfig.verification.json",
    "typecheck:all": "bun --no-env-file run typecheck && bun --no-env-file run --cwd web typecheck",
    "build": "bun --no-env-file run --cwd web build",
    "okx:market-scan": "bun --no-env-file run scripts/okx-market-scan.ts",
    "okx:dex-quote": "bun --no-env-file run scripts/okx-dex-quote.ts",
    "okx:signals": "bun --no-env-file run scripts/okx-signals.ts",
    "okx:evidence": "bun --no-env-file run scripts/okx-evidence.ts",
    "okx:defi": "bun --no-env-file run scripts/okx-defi.ts",
    "okx:operator": "bun run scripts/okx-operator.ts"
  }
}
