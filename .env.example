# Safe local paper configuration. No deposits, signing or borrowing.
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
# Optional WS_URL; polling works without WebSocket.
PRIVATE_KEY=
DRY_RUN=true
AUTO_DEPOSIT=false
LIVE_ACK=
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042
INFERENCE_BUDGET_TOKENS=2000
# USD paper example; NOT R$400 converted or a recommended allocation.
BANKROLL_USD=100
MARGIN_MON=200
# Legacy live funding target; not extra paper capital.
MARGIN_USDC=20
TRADE_SIZE_MON=200
MAX_POSITION_MON=1000
MAX_CAPITAL_FRACTION=0.25
QUOTE_INSIDE_TICKS=1
QUOTE_INTERVAL_BLOCKS=100
MIN_CONFIDENCE=0.65
# true = frozen readiness/profit gate. false = every-block mode (also set QUOTE_INTERVAL_BLOCKS=1 and MIN_CONFIDENCE=0). Operator decision; see docs/RELEASE-v0.0.2.md.
ECONOMIC_GATE=true
MAX_DECISION_MS=1500
MAX_LOSS_USD=2
MAX_SPEND_USD=1
MIN_NET_EDGE_USD=0.001
# Raw maker fee observed zero on 2026-10-09; recheck with doctor.
MAKER_FEE_BPS=0
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5
# Paper assumption: 350000 limit, current RPC gas price or 102 gwei fallback.
# Monad charges the limit. This is not a signed transaction gas estimate.
# GAS_LIMIT=350000
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2
PORT=3000
# One file per session; startup refuses to overwrite existing journal.
JOURNAL_PATH=data/session.jsonl
