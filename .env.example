# Safe local paper configuration. No deposits, signing or borrowing.
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
# Optional WS_URL; polling works without WebSocket.
PRIVATE_KEY=
DRY_RUN=true
AUTO_DEPOSIT=false
LIVE_ACK=
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042
INFERENCE_BUDGET_TOKENS=2000
# USD paper example; NOT R$400 converted or a recommended allocation.
BANKROLL_USD=100
MARGIN_MON=200
# Legacy live funding target; not extra paper capital.
MARGIN_USDC=20
TRADE_SIZE_MON=200
MAX_POSITION_MON=1000
MAX_CAPITAL_FRACTION=0.25
QUOTE_INSIDE_TICKS=1
QUOTE_INTERVAL_BLOCKS=100
MIN_CONFIDENCE=0.65
# true = frozen readiness/profit gate. false = every-block mode (also set QUOTE_INTERVAL_BLOCKS=1 and MIN_CONFIDENCE=0). Operator decision; see docs/RELEASE-v0.0.2.md.
ECONOMIC_GATE=true
MAX_DECISION_MS=1500
MAX_LOSS_USD=2
MAX_SPEND_USD=1
MIN_NET_EDGE_USD=0.001
# Raw maker fee observed zero on 2026-10-09; recheck with doctor.
MAKER_FEE_BPS=0
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5
# Paper assumption: 350000 limit, current RPC gas price or 102 gwei fallback.
# Monad charges the limit. This is not a signed transaction gas estimate.
# GAS_LIMIT=350000
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2
PORT=3000
# One file per session; startup refuses to overwrite existing journal.
JOURNAL_PATH=data/session.jsonl

# Jev as financial operator over the OKX Wallet inventory (scripts/okx-operator.ts).
# Read-only OKX OnChain OS credentials; leave empty for the offline synthetic demo.
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_API_PASSPHRASE=
# Public address observed by the inventory (never a private key).
OPERATOR_ADDRESS=
# chainIndex list, at most 50: 143 Monad, 196 X Layer, 501 Solana, 1 Ethereum, 56 BNB, 8453 Base, 42161 Arbitrum, 137 Polygon, 10 Optimism.
OPERATOR_CHAINS=143,196,501,1,56,8453,42161,137,10
# Policy profile: micro (default: 5 USD or 5% per plan, 20 USD and 4 plans per day, 15 min cooldown) or standard (25 USD, 25%, 100 USD, 10 plans, 2 min).
OPERATOR_PROFILE=micro
# Explicit values override the profile.
# OPERATOR_MAX_PLAN_USD=25
# OPERATOR_MAX_CAPITAL_FRACTION=0.25
OPERATOR_MIN_NET_USD=0.05
OPERATOR_MAX_PRICE_IMPACT_PERCENT=1
OPERATOR_MAX_QUOTE_AGE_MS=15000
OPERATOR_INTERVAL_MS=60000
# Deadline for the Jev decision of one cycle, ms (whole number, 1 to 30000). Past it the cycle records decision_timeout and sends nothing.
# OPERATOR_DECISION_TIMEOUT_MS=10000
# Execution gates are the operator's own; the trader's DRY_RUN, LIVE_ACK and PRIVATE_KEY are never consulted.
# Live needs all of: OPERATOR_EXECUTE=true, OPERATOR_LIVE_ACK=OWN_FUNDS_RISK_OPERATOR, OPERATOR_PRIVATE_KEY,
# --jev (real model), https RPC, router, spender and selector allowlists per chainIndex, and an initialized ledger.
# Run the operator with its own env file so it never inherits the trader's keys:
#   bun --no-env-file --env-file=.env.operator run scripts/okx-operator.ts --live --jev
OPERATOR_EXECUTE=false
# Empty means absent. Only OWN_FUNDS_RISK_OPERATOR opens this gate. A key equal to the trader PRIVATE_KEY is refused.
OPERATOR_LIVE_ACK=
# Dedicated operator wallet funded with at most the capital you accept losing; never the main wallet key.
OPERATOR_PRIVATE_KEY=
# OPERATOR_RPC_196=https://rpc.xlayer.tech
# Router contracts (tx.to from the swap endpoint), spender contracts (dexContractAddress from approve-transaction)
# and 4-byte selectors the executor may call, per chainIndex. Check every address on the explorer first.
# OPERATOR_ROUTER_196=0x...
# OPERATOR_SPENDER_196=0x...
# OPERATOR_SELECTORS_196=0x12345678
# Base58 secret of a dedicated Solana operator wallet. Solana live execution is disabled in code until a
# transaction policy exists, and nothing reads this key in production (the loader only checks its format), so the
# line stays commented out: do not put a secret in this shared template.
# SOLANA_PRIVATE_KEY=
# Cumulative limits enforced by data/operator/ledger.json; data/operator/STOP is the kill switch.
# OPERATOR_MAX_DAILY_NOTIONAL_USD=100
# OPERATOR_MAX_DAILY_PLANS=10
# OPERATOR_COOLDOWN_MS=120000
# Loss stops on reconciled realized results, gas included (micro: 2 USD per day, 5 per week, 10 drawdown).
# OPERATOR_MAX_DAILY_LOSS_USD=2
# OPERATOR_MAX_WEEKLY_LOSS_USD=5
# OPERATOR_MAX_DRAWDOWN_USD=10
# OPERATOR_MAX_GAS_LIMIT=1000000
# Exit window for the second leg after the first confirms, ms. 0 keeps the entry deadline for the exit (default).
# OPERATOR_EXIT_WINDOW_MS=0
# Ledger and lock files (absolute or relative to the repository root); create the ledger once with --init-ledger
# (--accept-history when a journal already exists). Close legs with --reconcile <planId> <closed|failed> --realized <usd>;
# that recorded result, gas included, is what feeds the daily, weekly and drawdown stops.
# OPERATOR_LEDGER_PATH=data/operator/ledger.json
# OPERATOR_LOCK_PATH=data/operator/LOCK
# Operator read endpoints on the backend: allowed dashboard origins and an optional bearer token.
# OPERATOR_DASHBOARD_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# OPERATOR_READ_TOKEN=
# Jev reads the tape (scripts/jev-read.ts, GET /jev-read): advisory buy/sell/hold on the live OKX public feed.
# The producer needs TYPESAFE_AI_API_KEY for --jev and uses the same dashboard origins and token as /operator.
# JEV_READ_STATE_PATH=data/jev-read/latest.json
# JEV_READ_JOURNAL_PATH=data/jev-read/reads.jsonl
OPERATOR_MAX_FEE_GWEI=400
# Unit and contract qualification: round trips and bridges from the OKX API stay research only until these are true.
OPERATOR_TRUST_QUOTE_UNITS=false
OPERATOR_TRUST_BRIDGE_API=false
