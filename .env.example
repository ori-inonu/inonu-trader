# Safe local paper configuration. No deposits, signing or borrowing.
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
# Optional WS_URL; polling works without WebSocket.
PRIVATE_KEY=
DRY_RUN=true
AUTO_DEPOSIT=false
LIVE_ACK=
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042
INFERENCE_BUDGET_TOKENS=2000
# USD paper example; NOT R$400 converted or a recommended allocation.
BANKROLL_USD=100
MARGIN_MON=200
# Legacy live funding target; not extra paper capital.
MARGIN_USDC=20
TRADE_SIZE_MON=200
MAX_POSITION_MON=1000
MAX_CAPITAL_FRACTION=0.25
QUOTE_INSIDE_TICKS=1
QUOTE_INTERVAL_BLOCKS=100
MIN_CONFIDENCE=0.65
# true = frozen readiness/profit gate. false = every-block mode (also set QUOTE_INTERVAL_BLOCKS=1 and MIN_CONFIDENCE=0). Operator decision; see docs/RELEASE-v0.0.2.md.
ECONOMIC_GATE=true
MAX_DECISION_MS=1500
MAX_LOSS_USD=2
MAX_SPEND_USD=1
MIN_NET_EDGE_USD=0.001
# Raw maker fee observed zero on 2026-10-09; recheck with doctor.
MAKER_FEE_BPS=0
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5
# Paper assumption: 350000 limit, current RPC gas price or 102 gwei fallback.
# Monad charges the limit. This is not a signed transaction gas estimate.
# GAS_LIMIT=350000
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2
PORT=3000
# One file per session; startup refuses to overwrite existing journal.
JOURNAL_PATH=data/session.jsonl

# Jev as financial operator over the OKX Wallet inventory (scripts/okx-operator.ts).
# Read-only OKX OnChain OS credentials; leave empty for the offline synthetic demo.
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_API_PASSPHRASE=
# Public address observed by the inventory (never a private key).
OPERATOR_ADDRESS=
# chainIndex list, at most 50: 143 Monad, 196 X Layer, 501 Solana, 1 Ethereum, 56 BNB, 8453 Base, 42161 Arbitrum, 137 Polygon, 10 Optimism.
OPERATOR_CHAINS=143,196,501,1,56,8453,42161,137,10
# Policy profile: micro (default: 5 USD or 5% per plan, 20 USD and 4 plans per day, 15 min cooldown) or standard (25 USD, 25%, 100 USD, 10 plans, 2 min).
OPERATOR_PROFILE=micro
# Explicit values override the profile.
# OPERATOR_MAX_PLAN_USD=25
# OPERATOR_MAX_CAPITAL_FRACTION=0.25
OPERATOR_MIN_NET_USD=0.05
OPERATOR_MAX_PRICE_IMPACT_PERCENT=1
OPERATOR_MAX_QUOTE_AGE_MS=15000
OPERATOR_INTERVAL_MS=60000
# Execution gate: plans stay dry run unless this, DRY_RUN=false, LIVE_ACK and a dedicated signer key are all set.
# Use a dedicated operator wallet funded with at most the capital you accept losing; never the main wallet key.
OPERATOR_EXECUTE=false
# OPERATOR_RPC_196=https://rpc.xlayer.tech
# OPERATOR_RPC_501=https://api.mainnet-beta.solana.com
# Router/spender contracts the executor may call, per chainIndex (OKX DEX router addresses from the OKX docs).
# OPERATOR_ROUTER_196=0x...
# OPERATOR_ROUTER_501=...
# Base58 secret of a dedicated Solana operator wallet (64-byte secret or 32-byte seed).
SOLANA_PRIVATE_KEY=
# Cumulative limits enforced by data/operator/ledger.json; data/operator/STOP is the kill switch.
# OPERATOR_MAX_DAILY_NOTIONAL_USD=100
# OPERATOR_MAX_DAILY_PLANS=10
# OPERATOR_COOLDOWN_MS=120000
# Daily loss stop on reconciled realized results (micro 2 USD, standard 5 USD).
# OPERATOR_MAX_DAILY_LOSS_USD=2
OPERATOR_MAX_FEE_GWEI=400
# Unit and contract qualification: round trips and bridges from the OKX API stay research only until these are true.
OPERATOR_TRUST_QUOTE_UNITS=false
OPERATOR_TRUST_BRIDGE_API=false
