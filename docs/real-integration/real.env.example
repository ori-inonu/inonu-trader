# Exemplo local: não contém credenciais nem concede consumo ou execução.
# O real:console entrega aos processos filhos apenas SystemRoot, WINDIR, TEMP, TMP, PATH e, ao backend, as variáveis
# deste arquivo que ele lê (REAL_UI_PORT e REAL_UI_MODE são do próprio console). Nada mais do ambiente nem de um .env
# do repositório chega a eles (src/real/console-env.ts).
REAL_PORT=3000
REAL_UI_PORT=3001
REAL_UI_MODE=dev
REAL_INTERVAL_MS=60000
REAL_JOURNAL_PATH=data/real/cycles.jsonl

# Preencher somente com credenciais Web3 próprias da aplicação.
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_API_PASSPHRASE=

# Chave da aplicação, independente do plugin consultivo.
TYPESAFE_AI_API_KEY=
REAL_JEV_MODEL=jev-latest
REAL_JEV_CONSUMPTION_AUTHORIZED=false
REAL_JEV_MAX_CALLS=10
# REAL_JEV_USD_PER_MILLION= custo verificado, se conhecido

# Par opcional: contratos reais da rede consentida e amount em unidade bruta.
# Configure os três juntos; ausência mantém cotação bloqueada.
# REAL_FROM_TOKEN=0x...
# REAL_TO_TOKEN=0x...
# REAL_AMOUNT= quantidade inteira positiva em unidade bruta
# REAL_SLIPPAGE_PERCENT=0.5
